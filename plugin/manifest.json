{
    "manifest_version": 3,
    "name": "ConciSafe",
    "description": "Unleash the world of pure content",
    "version": "1.0",
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
      },
    "permissions": ["tabs", "activeTab"],
    "content_scripts": [
      {
        "matches": ["https://*/*"],
        "js": ["jquery.min.js","content.js"]
      }
    ]
  }